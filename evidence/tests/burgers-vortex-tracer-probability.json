  "covariance_determinant": "sigma**6",
  "cylindrical_coordinate_jacobian": "exp(gamma*t)",
  "coordinate_flow_jacobian_matrix": "Matrix([[exp(-gamma*t), 0, 0], [theta_radial_shear, 1, 0], [0, 0, exp(2*gamma*t)]])",
  "physical_flow_jacobian": "1",
  "infinite_axis_tube_probability": "1 - exp(-radius**2*exp(2*gamma*t)/(2*sigma**2))",
  "finite_cylinder_probability": "(1 - exp(-radius**2*exp(2*gamma*t)/(2*sigma**2)))*erf(sqrt(2)*half_length*exp(-2*gamma*t)/(2*sigma))",
  "finite_cylinder_scaled_limit": "sqrt(2)*half_length/(sqrt(pi)*sigma)",
  "identities": {
    "inverse_flow_density_is_anisotropic_gaussian": true,
