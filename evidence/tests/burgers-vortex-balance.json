{
  "scope": "Symbolic cylindrical-coordinate verification of the classical Burgers vortex and its axis linearization; unbounded-domain exact solution, not a model of the pinned OpenAI field or molecules.",
  "sympy": "1.14.0",
  "source_sha256": "e1cfcc8ff05901b090741d5250483380ef8051d0b66bbb1dae37dcf1e67f90e9",
  "assumptions": [
    "r > 0",
    "gamma > 0",
    "nu > 0",
    "circulation > 0"
  ],
  "velocity": {
    "u_r": "-gamma*r",
    "u_theta": "circulation*(1 - exp(-gamma*r**2/(2*nu)))/(2*pi*r)",
    "u_z": "2*gamma*z"
  },
  "pressure_gradient": {
    "dp_dr": "circulation**2*(1 - exp(-gamma*r**2/(2*nu)))**2/(4*pi**2*r**3) - gamma**2*r",
    "dp_dz": "-4*gamma**2*z"
  },
  "identities": {
    "incompressible": true,
    "radial_balance": true,
    "axial_balance": true,
    "azimuthal_viscous_advection_balance": true,
    "azimuthal_viscous_term_nonzero_for_positive_r": true,
    "axis_swirling_rate": true,
    "axis_deformation_volume_preserved": true,
    "axis_directional_alignment_rate": true
  },
  "residuals": {
    "divergence": "0",
    "radial_pressure_balance": "0",
    "axial_pressure_balance": "0",
    "azimuthal_advection_minus_diffusion": "0",
    "azimuthal_advection": "-circulation*gamma**2*r*exp(-gamma*r**2/(2*nu))/(2*pi*nu)",
    "kinematic_diffusion": "-circulation*gamma**2*r*exp(-gamma*r**2/(2*nu))/(2*pi*nu**2)"
  },
  "axis_deformation_matrix": "Matrix([[exp(-gamma*t)*cos(circulation*gamma*t/(4*pi*nu)), -exp(-gamma*t)*sin(circulation*gamma*t/(4*pi*nu)), 0], [exp(-gamma*t)*sin(circulation*gamma*t/(4*pi*nu)), exp(-gamma*t)*cos(circulation*gamma*t/(4*pi*nu)), 0], [0, 0, exp(2*gamma*t)]])",
  "axis_transverse_to_axial_factor": "exp(-3*gamma*t)",
  "viscosity_coefficient": "nu",
  "azimuthal_advection_equals_viscous_diffusion": true,
  "negative_controls": {
    "wrong_strain_sign_rejected": true,
    "wrong_pressure_radial_sign_rejected": true
  },
  "success": true
}
