{
  "scope": "Exact calculation for the linearized, volume-preserving axis propagator applied to an isotropic Gaussian. It is not a finite-packet theorem for the nonlinear selected PDE.",
  "sympy": "1.14.0",
  "source_sha256": "e077e4b4a92b4444e786018f6752ef35f0e452a0f0cf1ff14fcf4183bf609f74",
  "assumptions": [
    "0 < q <= 1",
    "C > 0",
    "sigma > 0",
    "R > 0",
    "L > 0"
  ],
  "deformation": [
    [
      "q**(C/2)",
      "0",
      "0"
    ],
    [
      "0",
      "q**(C/2)",
      "0"
    ],
    [
      "0",
      "0",
      "q**(-C)"
    ]
  ],
  "covariance_eigenvalues": [
    "q**C*sigma**2",
    "q**C*sigma**2",
    "sigma**2/q**(2*C)"
  ],
  "covariance_determinant": "sigma**6",
  "gaussian_peak_density_ratio": "1",
  "fixed_ball_probability_upper_bound": "sqrt(2)*R*q**C/(sqrt(pi)*sigma)",
  "probability_within_fixed_radius_of_infinite_axis": "1 - exp(-R**2/(2*q**C*sigma**2))",
  "probability_within_fixed_radius_and_axial_half_length_L": "(exp(R**2/(2*q**C*sigma**2)) - 1)*exp(-R**2/(2*q**C*sigma**2))*erf(sqrt(2)*L*q**C/(2*sigma))",
  "bounded_cylinder_probability_over_q_to_C_limit": "sqrt(2)*L/(sqrt(pi)*sigma)",
  "directional_transverse_axial_factor": "q**(3*C/2)",
  "identities": {
    "volume_preserving_deformation": true,
    "transverse_variances_contract": true,
    "axial_variance_expands": true,
    "covariance_determinant_constant": true,
    "gaussian_peak_density_constant": true,
    "directional_transverse_axial_factor": true,
    "fixed_ball_bound_has_q_power": true,
    "transverse_tube_probability_tends_to_one": true,
    "bounded_axis_segment_probability_tends_to_zero": true,
    "bounded_axis_segment_leading_order_is_q_to_C": true
  },
  "negative_controls": {
    "non_volume_preserving_control_changes_covariance_determinant": true,
    "wrong_axial_variance_power_rejected": true
  },
  "interpretation": "The transverse marginal concentrates around the infinite axis, but axial variance expands: mass in any fixed finite cylinder or ball tends to zero. This reconciles axis-set concentration with no bounded-position certainty; it is only the linearized Gaussian model.",
  "success": true
}
