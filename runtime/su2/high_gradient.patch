+// Modified for concentration-aware-ns: smooth periodic transient 3D MMS.
 #include "../../../include/toolboxes/MMS/CUserDefinedSolution.hpp"
-
+namespace {
+constexpr su2double N=4.0;
+su2double env(const su2double q,const unsigned short order) {
+  const su2double amplitude[5]={35,56,28,8,1};
+  su2double value=0;
+  for(unsigned short mode=0;mode<=4;++mode) {
+    if(mode==0 && order>0) continue;
+    const su2double m=static_cast<su2double>(mode);
+    value+=amplitude[mode]*pow(m,order)*cos(m*q+order*acos(-1.0)/2);
+  }
+  return value/128.0;
+}
+void localized(const su2double* x,const su2double t,const su2double nu,su2double* u,su2double* f) {
+  const su2double gy[4]={env(x[1],0),env(x[1],1),env(x[1],2),env(x[1],3)};
+  const su2double hz[4]={env(x[2],0),env(x[2],1),env(x[2],2),env(x[2],3)};
+  const su2double chi=gy[0]*hz[0], cy=gy[1]*hz[0], cz=gy[0]*hz[1];
+  const su2double cyy=gy[2]*hz[0], czz=gy[0]*hz[2], cyz=gy[1]*hz[1];
+  const su2double cyyy=gy[3]*hz[0], cyzz=gy[1]*hz[2];
+  const su2double sx=sin(N*x[0]),cx=cos(N*x[0]),d=exp(-t);
+  const su2double v[3]={cy*sx/(N*N),-chi*cx/N,0};
+  const su2double grad[3][3]={{cy*cx/N,cyy*sx/(N*N),cyz*sx/(N*N)},
+                              {chi*sx,-cy*cx/N,-cz*cx/N},{0,0,0}};
+  const su2double lap[3]={sx*(-cy+(cyyy+cyzz)/(N*N)),
+                          cx*(N*chi-(cyy+czz)/N),0};
+  for(int i=0;i<3;++i) {
+    u[i]=d*v[i];
+    su2double conv=0;
+    for(int j=0;j<3;++j) conv+=grad[i][j]*v[j];
+    f[i]=-d*v[i]+d*d*conv-nu*d*lap[i];
+  }
+}
+}
