+  if(nd!=3 || Kind_Solver!=MAIN_SOLVER::INC_NAVIER_STOKES || config->GetEnergy_Equation())
+    SU2_MPI::Error("MMS requires 3D incompressible Navier Stokes with energy disabled", CURRENT_FUNCTION);
+  if(config->GetKind_FluidModel()!=CONSTANT_DENSITY || config->GetKind_ViscosityModel()!=VISCOSITYMODEL::CONSTANT)
+    SU2_MPI::Error("MMS requires constant density and viscosity", CURRENT_FUNCTION);
+  mmsDensity=config->GetDensity_FreeStreamND();
+  mmsNu=config->GetViscosity_FreeStreamND()/mmsDensity;
+  mmsTemperature=config->GetTemperature_FreeStreamND();
+  if(fabs(mmsDensity-1.0)>1e-12 || fabs(mmsNu-0.01)>1e-12)
+    SU2_MPI::Error("MMS benchmark requires nondimensional rho=1 and nu=0.01", CURRENT_FUNCTION);
