+namespace {
+void localized(const su2double* x, su2double t, su2double nu, su2double* u, su2double* f) {
+  const su2double a[3]={1,2,3};
+  su2double q[3],r[3],s[3],exponent=-t,trace=0;
+  for(int j=0;j<3;++j) {
+    const su2double d=x[j]-acos(-1.0);
+    q[j]=-sin(d)/0.25; r[j]=-cos(d)/0.25; s[j]=sin(d)/0.25;
+    exponent+=(cos(d)-1)/0.25; trace+=q[j]*q[j]+r[j];
+  }
+  const su2double psi=exp(exponent);
+  auto cross=[&](const su2double* v,su2double* out) {
+    for(int i=0;i<3;++i) out[i]=v[(i+1)%3]*a[(i+2)%3]-v[(i+2)%3]*a[(i+1)%3];
+  };
+  su2double g[3];for(int i=0;i<3;++i)g[i]=psi*q[i];cross(g,u);
+  su2double conv[3]={0,0,0};
+  for(int j=0;j<3;++j) {
+    su2double h[3],du[3];
+    for(int i=0;i<3;++i)h[i]=psi*(q[i]*q[j]+(i==j?r[i]:0));
+    cross(h,du);for(int i=0;i<3;++i)conv[i]+=u[j]*du[i];
+  }
+  su2double lg[3],lap[3];
+  for(int i=0;i<3;++i)lg[i]=psi*(q[i]*trace+2*q[i]*r[i]+s[i]);
+  cross(lg,lap);for(int i=0;i<3;++i)f[i]=-u[i]+conv[i]-nu*lap[i];
+}
+}
